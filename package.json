{
  "name": "mirage-x",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev": "pnpm --filter @mirage-x/core dev",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm build && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3"
  }
}
