{
  "name": "@mirage-x/core",
  "version": "0.1.0",
  "description": "MirageX shared definitions: Units, props and refs, used by @mirage-x/server and @mirage-x/mirror",
  "keywords": [
    "resonite",
    "react",
    "mirage-x"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rheniumNV/mirage-x.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rheniumNV/mirage-x/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/rheniumNV/mirage-x/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --tsconfig tsconfig.test.json --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@types/react": "^19.3.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
