{
  "name": "@mirage-x/virtual-object",
  "version": "0.0.0",
  "description": "Virtual object tree for MirageX mirror assets",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/virtualContext.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
