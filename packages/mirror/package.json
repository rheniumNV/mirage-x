{
  "name": "@mirage-x/mirror",
  "version": "0.0.0",
  "description": "MirageX Resonite asset mirror builder (output.brson pipeline)",
  "type": "module",
  "files": [
    "dist",
    "assets/**/*.brson"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --tsconfig tsconfig.test.json --test \"test/**/*.test.ts\"",
    "feedback": "pnpm feedback:fetch && pnpm feedback:attach",
    "feedback:fetch": "tsx --env-file=.env scripts/feedback/fetch.ts",
    "feedback:attach": "pnpm feedback:attach:core && pnpm feedback:attach:frame:simple && pnpm feedback:attach:frame:install",
    "feedback:attach:core": "tsx scripts/feedback/attachCore.ts",
    "feedback:attach:frame:simple": "tsx scripts/feedback/attachSimpleFrame.ts",
    "feedback:attach:frame:install": "tsx scripts/feedback/attachInstallFrame.ts"
  },
  "dependencies": {
    "@frdt/frdt": "^0.2.4",
    "@mirage-x/core": "workspace:^",
    "@mirage-x/virtual-object": "workspace:^",
    "axios": "^1.7.7",
    "brson.js": "^1.0.5"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
